      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "(sum(rate(http_requests_total{job=\"comments-api\",status=~\"5..\"}[1m])) / sum(rate(http_requests_total{job=\"comments-api\"}[1m]))) * 100", "legendFormat": "5xx Rate", "refId": "A" }],
      "title": "Taxa de Erro 5xx (SLO < 1%)",
      "type": "stat"
    },
    {
